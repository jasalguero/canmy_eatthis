{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@canmyeatthis/mobile", "exec", "expo", "start", "--web"],
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@canmyeatthis/api", "exec", "wrangler", "dev", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", "site"],
      "port": 8090
    }
  ]
}
