# services/api — real values live only in `wrangler secret put <NAME>` / the Cloudflare dashboard.
# Nothing in this file is a secret; it documents what must be set, per docs/03-api-contract.md
# and docs/10-hobby-scope.md §3.
#
# apps/mobile has its own .env.example for EXPO_PUBLIC_* vars (those get bundled into the
# client, so nothing secret ever belongs there either).

# Vision provider (paid tier only — see docs/10-hobby-scope.md §2.1)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Dev-mode session tokens (docs/03-api-contract.md — /v1/session dev mode). Must be OFF in production.
DEV_SESSION_TOKENS_ENABLED=false

# Global daily spend cap (docs/10-hobby-scope.md §3)
VISION_DAILY_CALL_CAP=500
