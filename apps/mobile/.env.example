# apps/mobile — public config only (EXPO_PUBLIC_ vars are bundled into the client, so nothing
# secret belongs here — AGENTS.md #6). Copy to .env and fill in for local dev.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# KB updates from the Worker (docs/02 D38). Both, or the feature stays off. Neither is a secret.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_KB_PUBLIC_KEY=
